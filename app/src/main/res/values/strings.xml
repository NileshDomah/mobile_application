    <!-- Privacy Notice screen (shown once, required, before sign-in/registration) -->
    <string name="privacy_notice_title">Before you continue</string>
    <string name="privacy_notice_intro">Here\'s what Shake to Report collects and why, in plain language.</string>
    <string name="privacy_notice_photos_title">Photos and videos</string>
    <string name="privacy_notice_photos_body">Report photos/videos are kept on your device only and attached to your report - we never upload them to a cloud storage service.</string>
    <string name="privacy_notice_location_title">Location</string>
    <string name="privacy_notice_location_body">Your GPS location is captured at the moment you submit a report, so it can be shown on the map and routed to the right department. Location isn\'t tracked at any other time.</string>
    <string name="privacy_notice_ai_title">AI photo analysis</string>
    <string name="privacy_notice_ai_body">Report photos are sent to an AI model to suggest a category (e.g. pothole, streetlight). This only happens for photos you submit as part of a report.</string>
    <string name="privacy_notice_account_title">Account information</string>
    <string name="privacy_notice_account_body">Your email, display name, and username are stored to identify your account and your own reports. You can submit a report anonymously if you\'d rather not attach your identity to it.</string>
    <string name="privacy_notice_notifications_title">Notifications</string>
    <string name="privacy_notice_notifications_body">We notify you about your own reports\' status changes and AI classification results. You can turn either off individually in Profile → Notifications.</string>
    <string name="privacy_notice_footer">You can review or change most of these choices later from Settings and Profile.</string>
    <string name="privacy_notice_acknowledge">I Understand, Continue</string>

