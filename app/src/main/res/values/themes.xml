<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Mob_app_assignment" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color: deep civic blue/teal. -->
        <item name="colorPrimary">@color/civic_blue</item>
        <item name="colorPrimaryVariant">@color/civic_blue_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color: amber accent for urgent report actions. -->
        <item name="colorSecondary">@color/civic_amber</item>
        <item name="colorSecondaryVariant">@color/civic_amber_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar / window background color, so there is no flash-of-wrong-color
             before Compose's AppTheme takes over. -->
        <item name="android:statusBarColor">@color/civic_blue_dark</item>
        <item name="android:windowBackground">@color/civic_blue_dark</item>
    </style>

    <!-- Android 12+ SplashScreen API theme: static branded splash shown while the app cold-starts,
         before MainActivity/AppTheme (Compose) take over. Applied only during the brief window
         SplashScreen.installSplashScreen() controls; MainActivity's own theme takes over after. -->
    <style name="Theme.Mob_app_assignment.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/civic_blue_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_app_logo</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/civic_blue_dark</item>
        <item name="postSplashScreenTheme">@style/Theme.Mob_app_assignment</item>
    </style>
</resources>