<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground layer (2026-08-31 redesign, replacing the default Android Studio
    template robot-head icon that was still in place - see PLACEHOLDERS_TODO.csv's app-icon
    row). A white phone+shake-motion mark, the same shape as ic_app_logo.xml's phone body
    (recolored white to sit on ic_launcher_background.xml's solid blue), scaled down and
    centered within the ~66dp safe zone Android's adaptive-icon spec keeps clear of the mask/
    cropping every launcher applies to this 108dp viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Phone body, scaled/centered from ic_app_logo.xml's 120x120 path into this 108x108 safe
         zone (roughly 0.5x scale, offset to center) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M45,35
            h18
            a5,5 0 0,1 5,5
            v32
            a5,5 0 0,1 -5,5
            h-18
            a5,5 0 0,1 -5,-5
            v-32
            a5,5 0 0,1 5,-5
            Z" />

    <!-- Screen inset -->
    <path
        android:fillColor="#1E5FD9"
        android:pathData="M47,39
            h14
            a2,2 0 0,1 2,2
            v28
            a2,2 0 0,1 -2,2
            h-14
            a2,2 0 0,1 -2,-2
            v-28
            a2,2 0 0,1 2,-2
            Z" />

    <!-- Shake-motion arcs either side -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M33,42 A17,17 0 0,0 33,68" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M75,42 A17,17 0 0,1 75,68" />
</vector>
