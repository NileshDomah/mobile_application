<?xml version="1.0" encoding="utf-8"?>
<!--
    App logo (2026-08-31 redesign) - a phone with shake-motion arcs, replacing the earlier
    shield+GPS-pin motif. Echoes the Home screen's own hero illustration and the app's name
    ("Shake to Report") more directly than a generic civic-shield symbol did, and uses the
    app's current bright-blue palette (CivicBlue10/40/90 in ui/theme/Color.kt) instead of the
    old teal/amber scheme this replaced. Used on the splash screen (values/themes.xml,
    values-night/themes.xml), the auth header (AuthBrandHeader.kt), and the onboarding screen.

    All content is kept within a ~72x72 safe zone centered in the 120x120 viewport (roughly
    x/y 24-96) - the Android 12+ SplashScreen API crops windowSplashScreenAnimatedIcon content
    outside a similar safe-zone convention to adaptive icons, and an earlier version of this
    file that let the shake-motion arcs extend all the way to the viewport's edges got them
    silently clipped off on the actual splash screen (only the phone body rendered). Keep any
    future redraw within that same safe zone.

    See ic_stat_notification.xml for the separate flattened single-color version required for
    the status bar - keep that file's silhouette in sync with this one's phone shape if this
    is ever redrawn again.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Phone body -->
    <path
        android:fillColor="#1E5FD9"
        android:pathData="M49,32
            h22
            a6,6 0 0,1 6,6
            v40
            a6,6 0 0,1 -6,6
            h-22
            a6,6 0 0,1 -6,-6
            v-40
            a6,6 0 0,1 6,-6
            Z" />

    <!-- Screen inset -->
    <path
        android:fillColor="#DCE6FF"
        android:pathData="M51.4,37.6
            h17.2
            a2.4,2.4 0 0,1 2.4,2.4
            v33.6
            a2.4,2.4 0 0,1 -2.4,2.4
            h-17.2
            a2.4,2.4 0 0,1 -2.4,-2.4
            v-33.6
            a2.4,2.4 0 0,1 2.4,-2.4
            Z" />

    <!-- Home indicator bar -->
    <path
        android:fillColor="#1E5FD9"
        android:fillAlpha="0.35"
        android:pathData="M56.8,78.4 h6.4 a1.2,1.2 0 0,1 0,2.4 h-6.4 a1.2,1.2 0 0,1 0,-2.4 Z" />

    <!-- Shake-motion arcs, left side (two concentric, fading outward) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E5FD9"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M37,45.4 A13.2,13.2 0 0,0 37,74.6" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E5FD9"
        android:strokeAlpha="0.7"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M31.4,41.8 A18.6,18.6 0 0,0 31.4,78.2" />

    <!-- Shake-motion arcs, right side (mirrored) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E5FD9"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M83,45.4 A13.2,13.2 0 0,1 83,74.6" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#1E5FD9"
        android:strokeAlpha="0.7"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:pathData="M88.6,41.8 A18.6,18.6 0 0,1 88.6,78.2" />
</vector>
