    <!-- Privacy Notice screen (shown once, required, before sign-in/registration) -->
    <string name="privacy_notice_title">Avant de continuer</string>
    <string name="privacy_notice_intro">Voici ce que Shake to Report collecte et pourquoi, en langage simple.</string>
    <string name="privacy_notice_photos_title">Photos et vidéos</string>
    <string name="privacy_notice_photos_body">Les photos/vidéos des signalements restent uniquement sur votre appareil et sont jointes à votre signalement - nous ne les téléversons jamais vers un service de stockage en ligne.</string>
    <string name="privacy_notice_location_title">Localisation</string>
    <string name="privacy_notice_location_body">Votre position GPS est capturée au moment où vous envoyez un signalement, afin qu\'elle puisse être affichée sur la carte et transmise au bon service. Votre position n\'est suivie à aucun autre moment.</string>
