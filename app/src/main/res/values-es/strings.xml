    <!-- Privacy Notice screen (shown once, required, before sign-in/registration) -->
    <string name="privacy_notice_title">Antes de continuar</string>
    <string name="privacy_notice_intro">Esto es lo que Shake to Report recopila y por qué, en lenguaje sencillo.</string>
    <string name="privacy_notice_photos_title">Fotos y vídeos</string>
    <string name="privacy_notice_photos_body">Las fotos/vídeos de los informes se guardan solo en tu dispositivo y se adjuntan a tu informe - nunca los subimos a un servicio de almacenamiento en la nube.</string>
