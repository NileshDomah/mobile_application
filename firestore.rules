rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Role is forced to CITIZEN on account creation, server-side - previously this only
      // checked the uid match, which meant a client could in principle set()
      // its own user doc with role: "ADMIN" on first write and the rule would have allowed it
      // (the app's own registration code never did this, but the rule itself didn't prevent it).
      // Admin accounts are never self-service - they only ever come from an admin manually
      // editing a user's role field directly in the Firestore console (see PLACEHOLDERS_TODO.csv).
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == 'CITIZEN';
      allow update: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /reports/{reportId} {
      // Anonymous reports (isAnonymous == true) store no owner at all - userId must be the
      // empty string, and the create is authorized purely by isSignedIn() (the submitter still
      // needs an account to use the app, that identity is just never attached to the document).
      // A non-anonymous report still requires the normal owner-match.
      allow create: if isSignedIn() &&
        (
          (request.resource.data.isAnonymous == true && request.resource.data.userId == '') ||
          (request.resource.data.isAnonymous == false && request.resource.data.userId == request.auth.uid)
        );
      // All reports are readable by any signed-in citizen, not just the owner/admin - this is
      // the actual intended design (the "All Reports" community tab, the map view, and upvoting
      // all depend on browsing everyone's reports, not just your own). Found via a real
      // PERMISSION_DENIED: getAllReports() queries the whole collection, and Firestore denies
      // the ENTIRE query the moment even one returned document would fail a narrower per-doc
      // read rule - a citizen-owner-only read rule was never actually compatible with a
      // "browse all reports" list/map feature querying the full collection in one shot.
      allow read: if isSignedIn();
      // Anonymous reports (userId == "") can never match resource.data.userId ==
      // request.auth.uid below, since a real Firebase Auth uid is never an empty string - so
      // they're implicitly excluded from the owner-edit and owner-delete paths without needing
      // an explicit isAnonymous check. Only isAdmin() or the upvote-only branch can touch them.
      // Admins keep full update rights (they update status via a separate path).
      // A non-admin owner may only edit their own report while it is still SUBMITTED, may not
      // change status themselves, and may only touch category/note/needsAiReview/
      // aiSuggestedCategory/wasResubmittedAfterAiReview - not photo/location/timestamp, which
      // are the evidentiary capture of the report and stay immutable. The AI-review-flag write
      // (needsAiReview + aiSuggestedCategory, from AiReviewCoordinator) and the user's manual
      // edit/resubmit-after-AI-review write (category + note, or all four AI-review fields at
      // once) both run through this same owner-update path, since there is no separate
      // server-side identity for the app's own background classification.
      // Any signed-in user (not just the owner or an admin) may toggle their upvote on someone
      // else's report - this is a deliberately separate access pattern from the owner-only edit
      // path above, scoped to touch only upvoteCount/upvotedByUids. We only check that these are
      // the sole affected keys, not that upvoteCount mathematically matches the new array length
      // (that would require re-deriving the diff length in rules syntax); a Cloud Function would
      // be the right place to enforce that rigorously in production - see PLACEHOLDERS_TODO.csv.
      allow update: if isSignedIn() &&
        (
          isAdmin() ||
          (
            resource.data.userId == request.auth.uid &&
            resource.data.status == 'SUBMITTED' &&
            request.resource.data.status == resource.data.status &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['category', 'customLabel', 'note', 'needsAiReview', 'aiSuggestedCategory', 'aiSuggestedCustomLabel', 'wasResubmittedAfterAiReview'])
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['upvoteCount', 'upvotedByUids'])
          )
        );
      // Citizens may delete only their own still-unreviewed (SUBMITTED) report as a self-service
      // "I made a mistake" action. Admins do not get delete - once in the system, they resolve
      // or track it, not remove it.
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        resource.data.status == 'SUBMITTED';
    }
  }
}
